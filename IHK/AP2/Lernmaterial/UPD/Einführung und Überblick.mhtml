 AP2\n    CoreSW --- AP3\n    CoreSW --- AP4\n    CoreSW --- AP5\n    CoreS=
W --- AP10\n\n    linkStyle 0,1,2,3,4,5 stroke-width:2px,stroke:green;\n   =
 linkStyle 6,7,8,9,10,11,12 stroke-width:4px,stroke:red;\n    linkStyle 13,=
14,15,16,17,18 stroke-width:2px,stroke:blue;\n\n    classDef abtswitch fill=
:#lightgreen;\n    class AbtSW1,AbtSW2,AbtSW3,AbtSW4,AbtSW5,AbtSW24 abtswit=
