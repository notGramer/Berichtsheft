e_haelfte):\n            if linke_haelfte[i] < rechte_haelfte[j]:\n        =
        arr[k] =3D linke_haelfte[i]\n                i +=3D 1\n            =
else:\n                arr[k] =3D rechte_haelfte[j]\n                j +=3D=
